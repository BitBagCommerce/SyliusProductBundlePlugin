{
    "name": "sylius/product-bundle-plugin",
    "type": "sylius-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "description": "Product bundle for Sylius.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.1"
    },
    "require-dev": {
        "behat/behat": "^3.22 || 4.0.0-alpha1",
        "behat/mink": "^1.10 || ^1.13",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink-browserkit-driver": "^1.6.3",
        "friends-of-behat/mink-debug-extension": "^2.2",
        "friends-of-behat/mink-extension": "^2.7 || 3.0.0-alpha1",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/suite-settings-extension": "^1.1 || ^1.2",
        "friends-of-behat/symfony-extension": "^2.6.2",
        "friends-of-behat/variadic-extension": "^1.6",
        "nelmio/alice": "^3.10",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^10.5",
        "sylius/test-application": "^2.0.0@alpha",
        "sylius-labs/behat-chrome-extension": "^1.5",
        "sylius-labs/coding-standard": "^4.4",
        "sylius-labs/suite-tags-extension": "~0.2 || ^0.3",
        "lchrusciel/api-test-case": "^6.0",
        "robertfausk/behat-panther-extension": "^1.1 || ^2.0",
        "symfony/webpack-encore-bundle": "^2.1",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/runtime": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Sylius\\ProductBundlePlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Sylius\\ProductBundlePlugin\\": ["tests/", "tests/TestApplication/src"]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "symfony/thanks": false,
            "php-http/discovery": true,
            "symfony/runtime": false,
            "symfony/flex": false
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    }
}
